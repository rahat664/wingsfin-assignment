# Copy this file to .env for local development.
# Do not commit .env or use these example credentials in production.
POSTGRES_USER=wingfin_demo
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=wingfin
POSTGRES_PORT=5433
DATABASE_URL=postgresql://wingfin_demo:replace-with-a-unique-local-password@localhost:5433/wingfin?schema=public

BACKEND_PORT=4000
FRONTEND_PORT=5173
MARKET_OPEN_TIME=10:00
MARKET_CLOSE_TIME=20:00
MARKET_TIMEZONE=Asia/Dhaka
DEFAULT_INDEX_SYMBOL=DSEX
DEFAULT_STOCK_SYMBOL=GP
MARKET_SIMULATOR_ENABLED=true
SIMULATOR_MAX_INTERVAL_MS=3000
INDEX_YESTERDAY_CLOSE=5222.22
STOCK_YESTERDAY_CLOSE=238.88
